@{
    ViewData["Title"] = "Thêm trạm sạc";
}

<h2>Thêm trạm sạc mới</h2>

<form asp-action="CreateStation" method="post">
     @Html.AntiForgeryToken()   
    <div class="form-group">
        <label>Tên trạm</label>
        <input type="text" name="name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Địa chỉ</label>
        <input type="text" name="address" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Số cổng</label>
        <input type="number" name="numberOfPorts" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Công suất (kW)</label>
        <input type="number" name="powerKW" step="0.1" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Thêm</button>
    <a href="/Admin/Stations" class="btn btn-secondary">Hủy</a>
</form>
