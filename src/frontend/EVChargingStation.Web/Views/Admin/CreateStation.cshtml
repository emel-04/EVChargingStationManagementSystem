@{
    ViewData["Title"] = "Thêm trạm sạc";
}

<h2>Thêm trạm sạc mới</h2>

<form asp-action="CreateStation" method="post">
     @Html.AntiForgeryToken()   
    <div class="form-group mb-3">
        <label>Tên trạm <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control" required placeholder="VD: Trạm sạc Quận 1" />
    </div>
    <div class="form-group mb-3">
        <label>Địa chỉ <span class="text-danger">*</span></label>
        <input type="text" name="address" class="form-control" required placeholder="VD: 123 Nguyễn Huệ, Quận 1, TP.HCM" />
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="form-group">
                <label>Vĩ độ (Latitude)</label>
                <input type="number" name="latitude" step="0.000001" class="form-control" value="10.776" placeholder="VD: 10.776" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Kinh độ (Longitude)</label>
                <input type="number" name="longitude" step="0.000001" class="form-control" value="106.700" placeholder="VD: 106.700" />
            </div>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="form-group">
                <label>Thành phố</label>
                <input type="text" name="city" class="form-control" placeholder="VD: Hồ Chí Minh" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Tỉnh/Thành</label>
                <input type="text" name="province" class="form-control" placeholder="VD: Hồ Chí Minh" />
            </div>
        </div>
    </div>
    <div class="form-group mb-3">
        <label>Trạng thái</label>
        <select name="status" class="form-control">
            <option value="1" selected>Online</option>
            <option value="2">Offline</option>
            <option value="3">Maintenance</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">
        <i class="fa fa-plus me-1"></i>Thêm trạm
    </button>
    <a href="/Admin/Stations" class="btn btn-secondary ms-2">Hủy</a>
</form>
