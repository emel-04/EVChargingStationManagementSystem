@{
    ViewData["Title"] = "Trạm sạc";
    var stations = ViewBag.Stations as List<EVChargingStation.Web.Models.StationDto> ?? new();
}

<div class="container py-3">
    <h4 class="mb-3 text-primary">
        <i class="fa fa-charging-station me-2"></i>Vị Trí Trạm Sạc
    </h4>

    <!-- Hiển thị thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (stations.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="fa fa-info-circle fa-2x mb-2"></i>
            <p>Hiện chưa có trạm sạc nào.</p>
        </div>
    }

    <div class="row g-3">
        @foreach (var s in stations)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm station-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold fs-5">@s.Name</div>
                                <div class="small text-muted">@s.Address</div>
                                @if (!string.IsNullOrEmpty(s.City))
                                {
                                    <div class="small text-muted">@s.City @(!string.IsNullOrEmpty(s.Province) ? $", {s.Province}" : "")</div>
                                }
                            </div>
                            @switch (s.Status)
                            {
                                case 1:
                                    <span class="badge bg-success">Online</span>
                                    break;
                                case 2:
                                    <span class="badge bg-secondary">Offline</span>
                                    break;
                                case 3:
                                    <span class="badge bg-warning text-dark">Bảo trì</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark">@s.Status</span>
                                    break;
                            }
                        </div>

                        @if (s.ChargingPoints != null && s.ChargingPoints.Any())
                        {
                            <div class="mt-2 small text-muted">
                                <i class="fa fa-plug me-1"></i>@s.ChargingPoints.Count trụ sạc
                            </div>
                        }

                        <div class="mt-3 d-flex gap-2">
                            @if (s.Latitude != 0 && s.Longitude != 0)
                            {
                                <a href="https://www.google.com/maps?q=@s.Latitude,@s.Longitude" target="_blank" class="btn btn-outline-primary btn-sm">
                                    <i class="fa fa-map-marker-alt me-1"></i>Chỉ đường
                                </a>
                            }
                            else
                            {
                                <a href="https://www.google.com/maps/search/@s.Address" target="_blank" class="btn btn-outline-primary btn-sm">
                                    <i class="fa fa-map-marker-alt me-1"></i>Chỉ đường
                                </a>
                            }

                            <!-- Nút đặt chỗ -->
                            
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
.station-card {
    transition: transform 0.2s, box-shadow 0.2s;
}
.station-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 15px rgba(0,0,0,0.1);
}
</style>
